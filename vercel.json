{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/trips/:guid([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
      "destination": "/client/21985a98-1505-4435-8317-6e3c0c3a0205/trips/:guid",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/client/:clientId/trips/:guid",
      "destination": "/api/og-trip?clientId=:clientId&guid=:guid"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/client/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
