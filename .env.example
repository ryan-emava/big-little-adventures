# Airtable configuration for the /api/quotes serverless function.
# Copy this file to .env.local (gitignored) for local dev, and set the same
# variables in your Vercel project settings for production.
#
# Without these, local dev falls back to sample quotes (see api/_sampleQuotes.js).

# Personal access token with the data.records:read scope, limited to your base.
# Create at https://airtable.com/create/tokens
AIRTABLE_TOKEN=

# Base id (starts with "app"). Find it in the Airtable API docs for your base,
# or in the base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=

# Table name (optional — defaults to "Quotes")
AIRTABLE_TABLE=Quotes
